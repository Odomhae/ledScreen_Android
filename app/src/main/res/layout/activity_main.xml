<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.odom.ledscreen.ColorSelectorDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black" >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preview"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/ll_background"
        app:flow_verticalAlign="center"
        app:flow_horizontalAlign="start"
        android:textColor="@color/neon_green"/>

    <LinearLayout
        android:id="@+id/ll_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:flow_horizontalAlign="center"
        android:gravity="center">

        <TextView
            android:id="@+id/textViewNote"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginVertical="10dp"
            android:text="love♥"
            android:ellipsize="none"
            android:singleLine="true"
            android:textColor="#de000000"
            android:background="@android:color/transparent"
            android:textSize="54dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_input"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="love♥"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:background="@color/dark_surface"
        android:paddingHorizontal="12dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/et_input"
        app:layout_constraintBottom_toTopOf="@+id/adContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/hsvPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/ll_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonSelector01"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:text="Back Color" />

                <Button
                    android:id="@+id/buttonSelector02"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="24dp"
                    android:text="Text Color" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_setting1"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonLeft"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_left"
                    android:background="@drawable/selector_background"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonRight"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_right"
                    android:background="@drawable/selector_background"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonPlus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_plus"
                    android:background="@drawable/selector_background"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonMinus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_minus"
                    android:background="@drawable/selector_background"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonSpeedSlow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_background"
                    android:textColor="@color/white"
                    android:text="@string/speed_slow" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonSpeedNormal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/selector_background"
                    android:textColor="@color/white"
                    android:text="@string/speed_normal" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonSpeedFast"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_background"
                    android:textColor="@color/white"
                    android:text="@string/speed_fast" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_setting2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/buttonBlink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:textSize="20dp"
                    android:text="Blink" />

                <Button
                    android:id="@+id/buttonStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="16dp"
                    android:textSize="25dp"
                    android:textStyle="bold"
                    android:text="START" />

            </LinearLayout>


        </LinearLayout>


    </ScrollView>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>

